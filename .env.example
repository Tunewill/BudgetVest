# Set these in Netlify: Site configuration > Environment variables
AUTH_SECRET=        # 32+ random characters, e.g. run: openssl rand -hex 32
RESEND_API_KEY=     # from resend.com (sends the OTP emails)
MAIL_FROM=BudgetVest <login@yourdomain.com>   # sender on a domain verified in Resend
GOOGLE_CLIENT_ID=   # OAuth Web client ID; add your Netlify URL under Authorized JavaScript origins
